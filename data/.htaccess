# The schedule and the answers are not for download: the game asks the REST API for today only.
# guesses.txt (the allowed-guess list) stays public; the game downloads it.
<FilesMatch "\.json$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
